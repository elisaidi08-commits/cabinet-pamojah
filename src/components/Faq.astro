---
// Questions fréquentes : liste dépliable native (<details>), accessible au clavier, sans carrousel.
interface Props {
  questions: { question: string; reponse: string }[];
}
const { questions } = Astro.props;

// Une adresse email saisie dans une réponse devient un lien « mailto: » (le texte reste du texte : aucun HTML n'est interprété).
const EMAIL = /([^\s@]+@[^\s@.]+\.[^\s@,;)]+)/g;
const morceaux = (reponse: string) => reponse.split(EMAIL).map((m, i) => ({ texte: m, email: i % 2 === 1 }));
---
<div class="faq">
  {questions.map((q) => (
    <details class="faq__item">
      <summary>
        <span>{q.question}</span>
        <span class="faq__signe" aria-hidden="true"></span>
      </summary>
      <div class="faq__reponse">
        <p>{morceaux(q.reponse).map((m) => (m.email ? <a href={`mailto:${m.texte}`}>{m.texte}</a> : m.texte))}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq { border-bottom: 1px solid var(--filet-clair); }
  .faq__item { border-top: 1px solid var(--filet-clair); }
  :global(.fond-noir) .faq, :global(.fond-noir) .faq__item { border-color: rgba(244, 238, 232, 0.18); }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-5);
    min-height: 64px;
    padding: var(--e-4) 0;
    font-size: clamp(22px, 0.6vw + 19px, 26px);
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--or-fonce); }
  :global(.fond-noir) summary:hover { color: var(--or); }

  .faq__signe {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .faq__signe::before, .faq__signe::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: var(--or);
    transition: transform var(--etat) var(--courbe);
  }
  .faq__signe::after { transform: rotate(90deg); }
  details[open] .faq__signe::after { transform: rotate(0); }

  .faq__reponse { padding: 0 0 var(--e-6); max-width: var(--lecture); }

  @media (prefers-reduced-motion: no-preference) {
    details[open] .faq__reponse { animation: faq-entre 200ms var(--courbe); }
    @keyframes faq-entre { from { opacity: 0; } to { opacity: 1; } }
  }
</style>
