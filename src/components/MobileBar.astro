---
// Téléphone : une seule action toujours à portée, la Consultation d'Axe.
// Masquée pendant le film et quand la réservation est déjà à l'écran.
import { site } from '../data/site';
---
<div class="barre est-masquee" data-barre hidden>
  <a class="bouton barre__action" href="/consultation-axe/#reserver">
    Réserver ma {site.consultation.name}
  </a>
</div>

<style>
  .barre {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    padding: 10px var(--gouttiere) calc(10px + env(safe-area-inset-bottom));
    background: var(--noir);
    transition: transform var(--etat) var(--courbe);
  }
  .barre.est-masquee,
  :global(html.consentement-ouvert) .barre { transform: translateY(110%); }
  .barre__action { width: 100%; min-height: 48px; }
  @media (min-width: 861px) { .barre { display: none; } }
</style>

<script>
  const barre = document.querySelector<HTMLElement>('[data-barre]');
  if (barre && window.matchMedia('(max-width: 860px)').matches) {
    barre.hidden = false;
    document.body.style.paddingBottom = '76px';
    const masques = document.querySelectorAll('[data-sans-barre]');
    const visibles = new Set<Element>();
    const maj = () => barre.classList.toggle('est-masquee', visibles.size > 0);
    const observer = new IntersectionObserver((entrees) => {
      entrees.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target)));
      maj();
    });
    masques.forEach((el) => observer.observe(el));
    // Pas d'appel immédiat : la barre reste masquée jusqu'au premier relevé de l'observateur.
    if (!masques.length) maj();
  }
</script>
