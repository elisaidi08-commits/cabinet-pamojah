---
// Avis clientes : des citations typographiques, sans carte ni carrousel, sans photo.
import { avis as tous, libelles, type Avis } from '../data/avis';
import { citer } from '../data/site';

interface Props {
  filtre?: Avis['accompagnement'][];
}
const { filtre } = Astro.props;
const liste = filtre ? tous.filter((a) => filtre.includes(a.accompagnement)) : tous;
---
{liste.length > 0 && (
  <ul class="citations" role="list">
    {liste.map((a, i) => (
      <li class="citation apparait" style={`--delai: ${i * 120}ms`}>
        <blockquote>
          <p>« {citer(a.citation)} »</p>
        </blockquote>
        <p class="citation__source">Cliente accompagnée · {libelles[a.accompagnement]}</p>
      </li>
    ))}
  </ul>
)}

<style>
  .citations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--e-8) var(--e-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .citation { padding-top: var(--e-5); border-top: 1px solid var(--or); }
  blockquote { margin: 0; }
  blockquote p {
    font-size: clamp(24px, 1.2vw + 18px, 32px);
    font-style: italic;
    line-height: 1.3;
  }
  .citation__source {
    margin-top: var(--e-5);
    font-family: var(--f-capitales);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--or-fonce);
  }
  :global(.fond-noir) .citation__source { color: var(--or); }
</style>
