---
// La Sphère de pouvoir : des cercles d'accès en fil doré, le Pilier au centre.
// Les cercles se tracent à l'entrée dans l'écran (une seule fois) ; image fixe si le mouvement est réduit.
import Logo from './Logo.astro';
---
<div class="cercles" data-cercles aria-hidden="true">
  <svg viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="0.8">
    <circle cx="200" cy="200" r="190" pathLength="1" />
    <circle cx="200" cy="200" r="145" pathLength="1" />
    <circle cx="200" cy="200" r="100" pathLength="1" />
    <circle cx="200" cy="200" r="55" pathLength="1" />
  </svg>
  <Logo variant="pilier" decorative class="cercles__pilier" />
</div>

<style>
  .cercles {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1;
    margin-inline: auto;
    color: var(--or);
  }
  .cercles svg { width: 100%; height: 100%; }
  .cercles :global(.cercles__pilier) {
    position: absolute;
    left: 50%;
    top: 50%;
    height: 22%;
    width: auto;
    color: var(--ivoire);
    transform: translate(-50%, -50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cercles circle {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 1600ms var(--courbe);
    }
    .cercles circle:nth-child(2) { transition-delay: 200ms; }
    .cercles circle:nth-child(3) { transition-delay: 400ms; }
    .cercles circle:nth-child(4) { transition-delay: 600ms; }
    .cercles.est-visible circle { stroke-dashoffset: 0; }
  }
</style>

<script>
  document.querySelectorAll('[data-cercles]').forEach((el) => {
    const observer = new IntersectionObserver((entrees) => {
      if (entrees.some((e) => e.isIntersecting)) {
        el.classList.add('est-visible');
        observer.disconnect();
      }
    }, { threshold: 0.4 });
    observer.observe(el);
  });
</script>
