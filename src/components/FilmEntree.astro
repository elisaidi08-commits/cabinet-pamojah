---
// Le film d'entrée : l'hôtel particulier parisien du Cabinet (souhait d'Huguette, 28/09/2026).
// On part du couloir aux arches, puis chaque pièce présente un accompagnement, et l'on finit
// sur le bureau d'accueil : la Consultation d'Axe, le point d'entrée de notre univers.
// Le scroll pilote le temps de la vidéo et le film ralentit à chaque texte pour laisser lire.
// Cinq plans, même récit dans les deux formats, chacun tourné dans son format : couloir · salon
// (Bilan de soi) · table de réunion (Madame la CEO) · bureau exécutif (Leadership durable) ·
// bureau d'accueil (Consultation d'Axe).
// Sans JavaScript ou avec le mouvement réduit : l'affiche et le texte d'ouverture.
import Logo from './Logo.astro';
import { services, consultationCarte, ACCES_COURT } from '../data/services';
import { empreinte } from '../data/fichiers';
import accueil from '../contenu/accueil.json';
const f = accueil.film;

// Deux temps : une version légère pour que le film réagisse vite, puis la HD en arrière-plan.
// L'empreinte du fichier fait partie de l'adresse : un film remplacé s'affiche tout de suite,
// sans attendre que le cache du navigateur (un jour) expire.
const SOURCES = {
  ordinateur: { leger: empreinte('/film/film-ordinateur-leger.mp4'), hd: empreinte('/film/film-ordinateur.mp4') },
  telephone: { leger: empreinte('/film/film-telephone-leger.mp4'), hd: empreinte('/film/film-telephone.mp4') },
};
---
<section
  class="film"
  id="film"
  aria-label="Film d’entrée : l’hôtel particulier du Cabinet Pamojah"
  data-film
  data-sources={JSON.stringify(SOURCES)}
>
  <div class="film__scene">
    <picture>
      <source media="(max-width: 860px) and (orientation: portrait)" srcset={empreinte('/film/affiche-telephone.jpg')} width="720" height="1280" />
      <img class="film__affiche" src={empreinte('/film/affiche-ordinateur.jpg')} width="1280" height="720" alt="" fetchpriority="high" />
    </picture>
    <video class="film__video" muted playsinline preload="auto" aria-hidden="true"></video>
    <div class="film__voile" aria-hidden="true"></div>
    <div class="film__ombre" aria-hidden="true"></div>

    <!-- L'ouverture : où sommes-nous ? -->
    <div class="film__legende film__ouverture" data-legende="ouverture" data-voile="0.58">
      <p class="surtitre">{f.ouvertureSurtitre}</p>
      <p class="film__lieu">{f.ouvertureTitre}</p>
      <p class="film__description">{f.ouvertureTexte}</p>
      <p class="film__indice" aria-hidden="true">{f.ouvertureIndice}</p>
    </div>

    <!-- L'arrivée : le logo et « Bienvenue » -->
    <div class="film__legende film__bienvenue" data-legende="bienvenue" data-voile="0.58">
      <Logo variant="principal" class="film__logo" />
      <p class="film__bienvenue-texte">{f.bienvenue}</p>
    </div>

    <!-- Une pièce par accompagnement : le salon, la table de réunion, le bureau exécutif -->
    {services.map((s) => (
      <div class="film__legende film__service" data-legende={s.slug} data-ombre>
        <p class="surtitre">Programme · {s.duree}</p>
        <p class="film__nom">{s.nom}</p>
        <p class="devise">{s.devise}</p>
        <p class="film__description">{s.description[0]}</p>
        <p class="film__acces">{ACCES_COURT}</p>
        <a class="lien" href={`/${s.slug}/`} aria-label={`Découvrir le programme ${s.nom}`}>Découvrir le programme</a>
      </div>
    ))}

    <!-- Le bureau d'accueil : la Consultation d'Axe (reste jusqu'à la fin du film) -->
    <div class="film__legende film__service" data-legende="consultation" data-ombre>
      <p class="surtitre">Le point d’entrée de notre univers</p>
      <p class="film__nom">{consultationCarte.nom}</p>
      <p class="devise">{consultationCarte.devise}</p>
      <p class="film__description">{consultationCarte.description}</p>
      <p class="film__acces">{consultationCarte.transformation}</p>
      <div class="film__actions">
        <a class="bouton" href="/consultation-axe/#reserver">Réserver ma Consultation d’Axe</a>
        <a class="lien" href={consultationCarte.href}>Découvrir la Consultation</a>
      </div>
    </div>

    <div class="film__progression" aria-hidden="true"><span></span></div>
    <a class="film__passer" href="#bienvenue" aria-label="Passer le film et entrer dans le site">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </a>
  </div>
</section>
<script is:inline>
  // Le film ne s'active que si le JavaScript tourne et que le mouvement n'est pas réduit.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.getElementById('film').classList.add('est-anime');
  // Déjà vu pendant cette visite (retour vers l'accueil par un lien) : on arrive directement dans le site.
  // Bouton Retour ou rechargement : le navigateur rend la position quittée, on n'y touche pas.
  try {
    var navigation = (performance.getEntriesByType('navigation')[0] || {}).type;
    if (sessionStorage.getItem('pamojah-film-vu') && !location.hash && navigation === 'navigate') {
      document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('bienvenue').scrollIntoView({ behavior: 'instant' });
      });
    }
  } catch (e) {}
</script>

<style>
  /* État par défaut (sans animation) : l'affiche et le texte d'ouverture. */
  .film {
    --p: 0;     /* avancement du film, 0 → 1 */
    position: relative;
    background: var(--noir);
  }
  .film__scene {
    position: relative;
    height: 88vh;
    height: 88dvh;
    overflow: hidden;
  }
  .film.est-anime { height: 900vh; }
  .film.est-anime .film__scene { position: sticky; top: 0; height: 100vh; height: 100dvh; }

  .film__affiche,
  .film__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film__video { opacity: 0; transition: opacity var(--etat) var(--courbe); }
  .film.est-pret .film__video { opacity: 1; }
  .film.est-pret .film__video--hd { opacity: 0; }
  .film.est-pret .film__video--hd.est-visible { opacity: 1; }

  /* Voile plein (ouverture, bienvenue) et ombre basse (légende de la Consultation) : réglés par le script. */
  .film__voile, .film__ombre { position: absolute; inset: 0; pointer-events: none; }
  .film__voile { background: var(--noir); opacity: 0.35; }
  .film.est-anime .film__voile { opacity: 0; }
  .film__ombre {
    background: linear-gradient(to top, rgba(13, 13, 13, 0.92) 0%, rgba(13, 13, 13, 0.7) 42%, rgba(13, 13, 13, 0) 82%);
    opacity: 0;
  }

  /* Légendes : invisibles par défaut, le script règle leur opacité selon l'image affichée. */
  .film__legende { position: absolute; color: var(--ivoire); opacity: 0; visibility: hidden; }
  .film:not(.est-anime) .film__legende:not(.film__ouverture) { display: none; }
  .film:not(.est-anime) .film__ouverture { opacity: 1; visibility: visible; }

  .film__ouverture {
    inset: 0;
    display: grid;
    align-content: start;
    justify-items: center;
    gap: var(--e-3);
    padding: 16vh var(--gouttiere) 0;
    text-align: center;
  }
  .film__ouverture .surtitre { color: var(--ivoire); opacity: 0.85; }
  .film__lieu { font-size: clamp(40px, 4vw + 18px, 76px); line-height: 1.05; }
  .film__ouverture .film__description { max-width: 30rem; }
  .film__indice {
    margin-top: var(--e-6);
    font-family: var(--f-capitales);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .film__indice::after {
    content: '';
    display: block;
    width: 1px;
    height: 40px;
    margin: var(--e-3) auto 0;
    background: var(--or);
  }

  .film__bienvenue {
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--e-6);
    padding: 0 var(--gouttiere) 10vh;
    text-align: center;
  }
  .film__bienvenue :global(.film__logo) { width: clamp(180px, 20vw, 260px); height: auto; }
  .film__bienvenue-texte { font-size: clamp(30px, 2.6vw + 16px, 48px); font-style: italic; line-height: 1.2; }

  .film__service {
    left: var(--gouttiere);
    bottom: calc(10vh + env(safe-area-inset-bottom));
    display: grid;
    justify-items: start;
    gap: var(--e-3);
    max-width: min(34rem, calc(100% - 2 * var(--gouttiere) - 56px));
  }
  .film__service .surtitre { color: var(--ivoire); opacity: 0.85; }  /* l'or manque de contraste sur l'image */
  .film__nom { font-size: clamp(34px, 2.6vw + 18px, 56px); line-height: 1.08; }
  .film__service .devise { color: var(--ivoire); }
  .film__description { margin-top: var(--e-2); font-size: clamp(19px, 0.4vw + 17px, 22px); line-height: 1.5; color: rgba(244, 238, 232, 0.9); }
  .film__service .lien { color: var(--ivoire); }
  .film__acces {
    font-family: var(--f-capitales);
    font-size: 12px;
    letter-spacing: 0.14em;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--or);
  }
  .film__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-3) var(--e-6); margin-top: var(--e-3); }


  /* Le fil doré de progression. */
  .film__progression {
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: rgba(179, 140, 61, 0.25);
  }
  .film__progression span {
    display: block;
    height: 100%;
    background: var(--or);
    transform: scaleX(var(--p));
    transform-origin: left;
  }
  .film:not(.est-anime) .film__progression { display: none; }

  /* Passer le film : le losange de la charte, cible de 48 px. */
  .film__passer {
    position: absolute;
    right: max(var(--gouttiere), env(safe-area-inset-right));
    bottom: calc(var(--e-5) + env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--ivoire);
    opacity: 0.75;
    transition: opacity var(--geste) var(--courbe);
  }
  .film__passer::before {
    content: '';
    position: absolute;
    width: 32px;
    height: 32px;
    border: 1px solid currentColor;
    transform: rotate(45deg);
  }
  .film__passer:hover, .film__passer:focus-visible { opacity: 1; }
  .film:not(.est-anime) .film__passer { display: none; }

  /* Téléphone : la légende de la Consultation est la plus longue ; on la resserre pour qu'elle tienne
     entièrement à l'écran, y compris sur les petits téléphones (360 × 640). */
  @media (max-width: 700px) {
    .film__service {
      bottom: calc(76px + env(safe-area-inset-bottom));
      gap: var(--e-2);
    }
    .film__nom { font-size: clamp(28px, 5.5vw + 10px, 40px); line-height: 1.1; }
    .film__service .film__description { margin-top: var(--e-2); font-size: 17px; line-height: 1.45; }
    .film__acces { line-height: 1.45; }
    .film__actions { margin-top: var(--e-2); }
  }

  @media (max-height: 700px) and (max-width: 700px) {
    .film__service { bottom: calc(64px + env(safe-area-inset-bottom)); }
    .film__service .devise { font-size: 15px; }
    .film__service .film__description { font-size: 16px; }
  }
</style>

<script>
  const film = document.querySelector<HTMLElement>('[data-film]');
  if (film?.classList.contains('est-anime')) {
    let video = film.querySelector<HTMLVideoElement>('.film__video')!;
    const voile = film.querySelector<HTMLElement>('.film__voile')!;
    const ombre = film.querySelector<HTMLElement>('.film__ombre')!;
    const telephone = window.matchMedia('(max-width: 860px) and (orientation: portrait)').matches;

    // Les deux montages, en secondes de film. rythme : [début, fin, poids] ; poids 3 = la caméra se pose,
    // il faut plus de scroll pour la même durée (le temps de lire). legendes : [apparition, disparition].
    type Montage = { duree: number; rythme: [number, number, number][]; legendes: Record<string, [number, number]> };
    // Les deux formats racontent le même film (26 s) : cinq plans de six secondes, fondus d'une seconde.
    // Couloir 0-5 · salon 6-10 · table de réunion 11-15 · bureau exécutif 16-20 · bureau d'accueil 21-26.
    const CINQ_PLANS: Montage = {
      duree: 26,
      rythme: [
        [0, 3.2, 2.5], [3.2, 4, 1],        // le couloir : le texte d'ouverture
        [4, 5.6, 2.5], [5.6, 6.6, 1],      // « Bienvenue », puis on entre dans le salon
        [6.6, 9.8, 2.5], [9.8, 11.4, 1],   // le salon : Bilan de soi
        [11.4, 14.8, 2.5], [14.8, 16.4, 1], // la table de réunion : Madame la CEO
        [16.4, 19.8, 2.5], [19.8, 21.6, 1], // le bureau exécutif : Leadership durable
        [21.6, 99, 2.5],                    // le bureau d'accueil : la Consultation d'Axe
      ],
      legendes: {
        ouverture: [-1, 3.2],
        bienvenue: [4, 5.6],
        'bilan-de-soi': [6.6, 9.8],
        'madame-la-ceo': [11.4, 14.8],
        'leadership-durable': [16.4, 19.8],
        consultation: [21.6, 99],
      },
    };
    const MONTAGES: Record<'ordinateur' | 'telephone', Montage> = { ordinateur: CINQ_PLANS, telephone: CINQ_PLANS };
    const montage = telephone ? MONTAGES.telephone : MONTAGES.ordinateur;

    const legendes = [...film.querySelectorAll<HTMLElement>('[data-legende]')].map((el) => ({
      el,
      debut: montage.legendes[el.dataset.legende!]?.[0] ?? -1,
      fin: montage.legendes[el.dataset.legende!]?.[1] ?? -1,
      ombre: el.hasAttribute('data-ombre'),       // ombre basse (légende de la Consultation)
      voile: Number(el.dataset.voile ?? 0),       // voile plein (ouverture, bienvenue)
    }));

    // Les adresses des vidéos (avec l'empreinte du fichier) sont posées par le gabarit.
    const SOURCES = JSON.parse(film.dataset.sources!) as Record<'ordinateur' | 'telephone', { leger: string; hd: string }>;
    const LISSAGE = 0.2;   // part de l'écart rattrapée à chaque image
    const FONDU = 0.3;     // durée des fondus des textes, en secondes de film

    const sources = telephone ? SOURCES.telephone : SOURCES.ordinateur;
    // Durée du montage : les textes suivent le scroll même avant que la vidéo soit prête (connexion lente).
    const DUREE_FILM = montage.duree;
    const RYTHME = montage.rythme;

    let avancement = 0;
    let temps = 0;      // temps du film affiché, lissé
    let duree = 0;      // durée réelle, connue quand la vidéo est prête
    let enCours = false;

    const tempsPour = (p: number) => {
      const fin = duree || DUREE_FILM;
      const segments = RYTHME.map(([a, b, poids]) => [a, Math.min(b, fin), poids]).filter(([a, b]) => b > a);
      const total = segments.reduce((s, [a, b, poids]) => s + (b - a) * poids, 0);
      let reste = p * total;
      for (const [a, b, poids] of segments) {
        const longueur = (b - a) * poids;
        if (reste <= longueur) return a + reste / poids;
        reste -= longueur;
      }
      return fin;
    };

    const memoriser = () => {
      try { sessionStorage.setItem('pamojah-film-vu', '1'); } catch {}
    };

    const mesurer = () => {
      const course = film.offsetHeight - window.innerHeight;
      avancement = course > 0 ? Math.min(1, Math.max(0, -film.getBoundingClientRect().top / course)) : 1;
      if (avancement > 0.97) memoriser();
    };

    // « Passer le film » : saut immédiat dans le site (sans faire défiler tout le film).
    film.querySelector('.film__passer')?.addEventListener('click', (e) => {
      e.preventDefault();
      memoriser();
      const cible = document.getElementById('bienvenue');
      cible?.scrollIntoView({ behavior: 'instant' });
      cible?.focus({ preventScroll: true });
    });

    // Affiche les textes selon l'image du film réellement à l'écran.
    const peindre = () => {
      film.style.setProperty('--p', avancement.toFixed(4));
      let voileMax = 0;
      let ombreMax = 0;
      for (const l of legendes) {
        const o = Math.min(1, Math.max(0, (temps - l.debut) / FONDU)) * Math.min(1, Math.max(0, (l.fin - temps) / FONDU));
        l.el.style.opacity = o.toFixed(3);
        l.el.style.visibility = o > 0.02 ? 'visible' : 'hidden';
        l.el.style.transform = `translateY(${((1 - o) * 12).toFixed(1)}px)`;
        if (l.ombre) ombreMax = Math.max(ombreMax, o);
        voileMax = Math.max(voileMax, o * l.voile);
      }
      voile.style.opacity = voileMax.toFixed(3);
      ombre.style.opacity = ombreMax.toFixed(3);
    };

    const image = () => {
      const cible = tempsPour(avancement);
      temps += (cible - temps) * LISSAGE;
      if (Math.abs(cible - temps) < 0.003) temps = cible;
      peindre();
      // Pas de nouveau déplacement tant que le décodeur n'a pas fini le précédent (téléphones).
      if (duree && !video.seeking && Math.abs(video.currentTime - temps) > 0.01) {
        video.currentTime = Math.min(temps, duree - 0.05);
      }
      if (temps !== cible || video.seeking) requestAnimationFrame(image);
      else enCours = false;
    };

    let hdDemandee = false;
    const demanderHd = () => {
      if (hdDemandee || !hdPermise || !duree || avancement < 0.01) return;
      hdDemandee = true;
      passerEnHd(sources.hd);
    };

    const auScroll = () => {
      mesurer();
      demanderHd();
      if (!enCours) {
        enCours = true;
        requestAnimationFrame(image);
      }
    };

    const figer = () => {
      window.removeEventListener('scroll', auScroll);
      window.removeEventListener('resize', auScroll);
      film.classList.remove('est-anime');
      film.style.removeProperty('--p');
      voile.style.removeProperty('opacity');
      ombre.style.removeProperty('opacity');
      legendes.forEach((l) => l.el.removeAttribute('style'));
    };

    // Attend un évènement de la vidéo ; renvoie false si rien n'arrive dans le délai.
    const attendre = (el: HTMLVideoElement, evenement: string, delai: number) =>
      new Promise<boolean>((ok, ko) => {
        const minuterie = setTimeout(() => ok(false), delai);
        el.addEventListener(evenement, () => { clearTimeout(minuterie); ok(true); }, { once: true });
        el.addEventListener('error', () => { clearTimeout(minuterie); ko(new Error('vidéo illisible')); }, { once: true });
      });

    const amorcer = (el: HTMLVideoElement) => el.play().then(() => el.pause()).catch(() => {});

    // Chargée en mémoire, une vidéo se parcourt dans les deux sens chez tous les hébergeurs.
    // Safari (iPhone) ne charge rien tant qu'on ne le lui demande pas explicitement : preload « auto »,
    // load(), puis une lecture muette aussitôt mise en pause (autorisée), qui déclenche aussi l'affichage des images.
    const remplir = async (el: HTMLVideoElement, url: string) => {
      const reponse = await fetch(url);
      if (!reponse.ok) throw new Error(`HTTP ${reponse.status}`);
      el.preload = 'auto';
      el.src = URL.createObjectURL(await reponse.blob());
      el.load();
      const charge = attendre(el, 'loadeddata', 6000);
      amorcer(el);
      if (await charge) return;
      // iPhone en mode économie d'énergie : même la lecture muette est bloquée jusqu'au premier toucher de l'écran.
      await new Promise<void>((ok) => {
        const auToucher = () => amorcer(el);
        window.addEventListener('touchend', auToucher, { once: true, passive: true });
        window.addEventListener('click', auToucher, { once: true });
        el.addEventListener('loadeddata', () => ok(), { once: true });
      });
    };

    // Pas de HD en mode économie de données ou sur une connexion lente.
    const connexion = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const hdPermise = !(connexion?.saveData || /(^|-)(2g|3g)$/.test(connexion?.effectiveType ?? ''));

    const passerEnHd = async (url: string) => {
      const hd = video.cloneNode(false) as HTMLVideoElement;
      hd.removeAttribute('src');
      hd.classList.add('film__video--hd');
      video.after(hd);
      try {
        await remplir(hd, url);
        hd.currentTime = Math.min(temps, duree - 0.05);
        if (!(await attendre(hd, 'seeked', 4000))) throw new Error('HD trop lente');
        hd.classList.add('est-visible');
        const ancienne = video;
        video = hd;
        auScroll();
        setTimeout(() => {
          URL.revokeObjectURL(ancienne.src);
          ancienne.remove();
        }, 600);
      } catch {
        if (hd.src.startsWith('blob:')) URL.revokeObjectURL(hd.src);
        hd.remove();  // on garde la version légère
      }
    };

    const charger = async () => {
      try {
        await remplir(video, sources.leger);
        duree = video.duration;
        film.classList.add('est-pret');
        auScroll();
      } catch (erreur) {
        console.warn('Film indisponible : image fixe.', erreur);
        figer();
        return;
      }
      demanderHd();
    };

    window.addEventListener('scroll', auScroll, { passive: true });
    window.addEventListener('resize', auScroll);
    mesurer();
    peindre();

    // Film déjà vu (arrivée directe dans le site) : la vidéo ne se charge que si l'on remonte dans le film.
    let dejaVu = false;
    try { dejaVu = Boolean(sessionStorage.getItem('pamojah-film-vu')); } catch {}
    if (!dejaVu) charger();
    else {
      const guet = new IntersectionObserver((entrees) => {
        if (entrees.some((e) => e.isIntersecting)) {
          guet.disconnect();
          charger();
        }
      }, { rootMargin: '-25% 0px' });
      guet.observe(film);
    }
  }
</script>
