---
// Le film d'entrée (09_SITE_V2/05-film-d-entree.md) : la villa, le cabinet, la lampe, l'ordinateur, le livre.
// Le scroll pilote le temps de la vidéo. Les textes apparaissent quand la caméra se pose :
// devant la villa, un texte pour situer le lieu ; « Bienvenue chez Pamojah » à l'arrivée dans le cabinet ;
// puis les trois services sur leur objet : lampe → Bilan de soi, ordinateur → Madame la CEO,
// livre (le livret d'axe) → la Consultation d'Axe, point d'entrée obligatoire. Pas d'écran de clôture :
// après le livre, on entre directement dans le site.
// À ces moments, le film ralentit (plus de scroll pour la même durée) pour laisser le temps de lire.
// Un seul film 16:9 : le téléphone en reçoit la bande centrale.
// Sans JavaScript ou avec le mouvement réduit : l'image de la villa et le texte d'ouverture.
import Logo from './Logo.astro';
import { services, consultationCarte, ACCES } from '../data/services';
import accueil from '../contenu/accueil.json';
const f = accueil.film;

// Fenêtres d'apparition, en secondes du film assemblé (20,7 s) : la caméra est posée sur le sujet.
const [bilan, ceo] = services;
const programmes = [
  { s: bilan, debut: 9.8, fin: 11.4 },   // la lampe
  { s: ceo, debut: 15.0, fin: 16.3 },    // l'ordinateur
];
---
<section class="film" id="film" aria-label="Film d’entrée : la villa et le cabinet Pamojah" data-film data-sans-barre>
  <div class="film__scene">
    <img
      class="film__affiche"
      src="/film/affiche-ordinateur.jpg"
      data-affiche-telephone="/film/affiche-telephone.jpg"
      alt=""
      fetchpriority="high"
    />
    <video class="film__video" muted playsinline preload="none" aria-hidden="true"></video>
    <div class="film__voile" aria-hidden="true"></div>
    <div class="film__ombre" aria-hidden="true"></div>

    <!-- Devant la villa : où sommes-nous ? -->
    <div class="film__legende film__ouverture" data-legende data-avant data-voile="0.35" data-debut="-1" data-fin="2.4">
      <p class="surtitre">{f.ouvertureSurtitre}</p>
      <p class="film__lieu">{f.ouvertureTitre}</p>
      <p class="film__description">{f.ouvertureTexte}</p>
      <p class="film__indice" aria-hidden="true">{f.ouvertureIndice}</p>
    </div>

    <!-- Arrivée dans le cabinet -->
    <div class="film__legende film__bienvenue" data-legende data-voile="0.5" data-debut="4.85" data-fin="6.05">
      <Logo variant="principal" class="film__logo" />
      <p class="film__bienvenue-texte">{f.bienvenue}</p>
    </div>

    <!-- Les deux programmes, chacun sur son objet -->
    {programmes.map(({ s, debut, fin }) => (
      <div class="film__legende film__service" data-legende data-debut={debut} data-fin={fin} data-ombre>
        <p class="surtitre">Programme · {s.duree} · {s.objet.nom}</p>
        <p class="film__nom">{s.nom}</p>
        <p class="devise">{s.devise}</p>
        <p class="film__description">{s.description[0]}</p>
        <p class="film__acces">{ACCES}</p>
        <a class="lien" href={`/${s.slug}/`} aria-label={`Découvrir le programme ${s.nom}`}>Découvrir le programme</a>
      </div>
    ))}

    <!-- Le livre : la Consultation d'Axe, porte d'entrée de tout le Cabinet (reste jusqu'à la fin du film) -->
    <div class="film__legende film__service" data-legende data-debut="19.3" data-fin="99" data-ombre>
      <p class="surtitre">Le point d’entrée · {consultationCarte.objet.nom}</p>
      <p class="film__nom">{consultationCarte.nom}</p>
      <p class="devise">{consultationCarte.devise}</p>
      <p class="film__description">{consultationCarte.description}</p>
      <p class="film__acces">{consultationCarte.transformation}</p>
      <div class="film__actions">
        <a class="bouton" href="/consultation-axe/#reserver">Réserver ma Consultation d’Axe</a>
        <a class="lien" href={consultationCarte.href}>Découvrir la Consultation</a>
      </div>
    </div>

    <div class="film__progression" aria-hidden="true"><span></span></div>
    <a class="film__passer" href="#bienvenue" aria-label="Passer le film et entrer dans le site">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </a>
  </div>
</section>
<script is:inline>
  // Le film ne s'active que si le JavaScript tourne et que le mouvement n'est pas réduit.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.getElementById('film').classList.add('est-anime');
  // Déjà vu pendant cette visite (retour depuis une autre page) : on arrive directement dans le site.
  try {
    if (sessionStorage.getItem('pamojah-film-vu') && !location.hash) {
      history.scrollRestoration = 'manual';
      document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('bienvenue').scrollIntoView({ behavior: 'instant' });
      });
    }
  } catch (e) {}
</script>

<style>
  /* État par défaut (sans animation) : l'image de la villa et le texte d'ouverture. */
  .film {
    --p: 0;     /* avancement du film, 0 → 1 */
    position: relative;
    background: var(--noir);
  }
  .film__scene {
    position: relative;
    height: 88vh;
    height: 88dvh;
    overflow: hidden;
  }
  .film.est-anime { height: 1000vh; }
  .film.est-anime .film__scene { position: sticky; top: 0; height: 100vh; height: 100dvh; }

  .film__affiche,
  .film__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film__video { opacity: 0; transition: opacity var(--etat) var(--courbe); }
  .film.est-pret .film__video { opacity: 1; }
  .film.est-pret .film__video--hd { opacity: 0; }
  .film.est-pret .film__video--hd.est-visible { opacity: 1; }

  /* Voile plein (bienvenue, clôture) et ombre basse (légendes des accompagnements) : réglés par le script. */
  .film__voile, .film__ombre { position: absolute; inset: 0; pointer-events: none; }
  .film__voile { background: var(--noir); opacity: 0.35; }
  .film.est-anime .film__voile { opacity: 0; }
  .film__ombre {
    background: linear-gradient(to top, rgba(13, 13, 13, 0.92) 0%, rgba(13, 13, 13, 0.7) 42%, rgba(13, 13, 13, 0) 82%);
    opacity: 0;
  }

  /* Légendes : invisibles par défaut, le script règle leur opacité selon l'image affichée. */
  .film__legende { position: absolute; color: var(--ivoire); opacity: 0; visibility: hidden; }
  .film:not(.est-anime) .film__legende:not(.film__ouverture) { display: none; }
  .film:not(.est-anime) .film__ouverture { opacity: 1; visibility: visible; }

  .film__ouverture {
    inset: 0;
    display: grid;
    align-content: start;
    justify-items: center;
    gap: var(--e-3);
    padding: 16vh var(--gouttiere) 0;
    text-align: center;
  }
  .film__ouverture .surtitre { color: var(--ivoire); opacity: 0.85; }
  .film__lieu { font-size: clamp(40px, 4vw + 18px, 76px); line-height: 1.05; }
  .film__ouverture .film__description { max-width: 30rem; }
  .film__indice {
    margin-top: var(--e-6);
    font-family: var(--f-capitales);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .film__indice::after {
    content: '';
    display: block;
    width: 1px;
    height: 40px;
    margin: var(--e-3) auto 0;
    background: var(--or);
  }

  .film__bienvenue {
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--e-6);
    padding: 0 var(--gouttiere) 10vh;
    text-align: center;
  }
  .film__bienvenue :global(.film__logo) { width: clamp(180px, 20vw, 260px); height: auto; }
  .film__bienvenue-texte { font-size: clamp(30px, 2.6vw + 16px, 48px); font-style: italic; line-height: 1.2; }

  .film__service {
    left: var(--gouttiere);
    bottom: calc(10vh + env(safe-area-inset-bottom));
    display: grid;
    justify-items: start;
    gap: var(--e-3);
    max-width: min(34rem, calc(100% - 2 * var(--gouttiere) - 56px));
  }
  .film__service .surtitre { color: var(--ivoire); opacity: 0.85; }  /* l'or manque de contraste sur l'image */
  .film__nom { font-size: clamp(34px, 2.6vw + 18px, 56px); line-height: 1.08; }
  .film__service .devise { color: var(--ivoire); }
  .film__description { margin-top: var(--e-2); font-size: clamp(19px, 0.4vw + 17px, 22px); line-height: 1.5; color: rgba(244, 238, 232, 0.9); }
  .film__service .lien { color: var(--ivoire); }
  .film__acces {
    font-family: var(--f-capitales);
    font-size: 12px;
    letter-spacing: 0.14em;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--or);
  }
  .film__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-3) var(--e-6); margin-top: var(--e-3); }


  /* Le fil doré de progression. */
  .film__progression {
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: rgba(179, 140, 61, 0.25);
  }
  .film__progression span {
    display: block;
    height: 100%;
    background: var(--or);
    transform: scaleX(var(--p));
    transform-origin: left;
  }
  .film:not(.est-anime) .film__progression { display: none; }

  /* Passer le film : le losange de la charte, cible de 48 px. */
  .film__passer {
    position: absolute;
    right: max(var(--gouttiere), env(safe-area-inset-right));
    bottom: calc(var(--e-5) + env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--ivoire);
    opacity: 0.75;
    transition: opacity var(--geste) var(--courbe);
  }
  .film__passer::before {
    content: '';
    position: absolute;
    width: 32px;
    height: 32px;
    border: 1px solid currentColor;
    transform: rotate(45deg);
  }
  .film__passer:hover, .film__passer:focus-visible { opacity: 1; }
  .film:not(.est-anime) .film__passer { display: none; }

  @media (max-width: 700px) {
    .film__service { bottom: calc(88px + env(safe-area-inset-bottom)); }
  }
</style>

<script>
  const film = document.querySelector<HTMLElement>('[data-film]');
  if (film?.classList.contains('est-anime')) {
    let video = film.querySelector<HTMLVideoElement>('.film__video')!;
    const affiche = film.querySelector<HTMLImageElement>('.film__affiche')!;
    const voile = film.querySelector<HTMLElement>('.film__voile')!;
    const ombre = film.querySelector<HTMLElement>('.film__ombre')!;
    const legendes = [...film.querySelectorAll<HTMLElement>('[data-legende]')].map((el) => ({
      el,
      debut: Number(el.dataset.debut),
      fin: Number(el.dataset.fin),
      ombre: el.hasAttribute('data-ombre'),       // ombre basse (textes des services)
      voile: Number(el.dataset.voile ?? 0),       // voile plein (ouverture, bienvenue)
      avant: el.hasAttribute('data-avant'),       // visible avant même le chargement du film
    }));

    // Deux temps : une version légère pour que le film réagisse vite, puis la HD en arrière-plan.
    const SOURCES = {
      ordinateur: { leger: '/film/film-ordinateur-leger.mp4', hd: '/film/film-ordinateur.mp4' },
      telephone: { leger: '/film/film-telephone-leger.mp4', hd: '/film/film-telephone.mp4' },
    };
    const LISSAGE = 0.14;  // part de l'écart rattrapée à chaque image
    const FONDU = 0.3;     // durée des fondus des textes, en secondes de film

    // Le film ralentit là où la caméra se pose (poids 3) : plus de scroll pour lire.
    const RYTHME: [number, number, number][] = [
      [0, 2.4, 2], [2.4, 4.6, 1],        // devant la villa (texte d'ouverture) · l'allée, la porte
      [4.6, 6.05, 3],                     // l'arrivée dans le cabinet
      [6.05, 9.6, 1], [9.6, 11.4, 3],    // vers la lampe · la lampe (Bilan de soi)
      [11.4, 14.8, 1], [14.8, 16.3, 3],  // vers l'ordinateur · l'ordinateur (Madame la CEO)
      [16.3, 19.2, 1], [19.2, 99, 3],    // vers le livre · le livre (la Consultation d'Axe)
    ];

    const telephone = window.matchMedia('(max-width: 860px) and (orientation: portrait)').matches;
    if (telephone && affiche.dataset.afficheTelephone) affiche.src = affiche.dataset.afficheTelephone;

    let avancement = 0;
    let temps = 0;      // temps du film affiché, lissé
    let duree = 0;
    let enCours = false;

    const tempsPour = (p: number) => {
      const segments = RYTHME.map(([a, b, poids]) => [a, Math.min(b, duree), poids]).filter(([a, b]) => b > a);
      const total = segments.reduce((s, [a, b, poids]) => s + (b - a) * poids, 0);
      let reste = p * total;
      for (const [a, b, poids] of segments) {
        const longueur = (b - a) * poids;
        if (reste <= longueur) return a + reste / poids;
        reste -= longueur;
      }
      return duree;
    };

    const memoriser = () => {
      try { sessionStorage.setItem('pamojah-film-vu', '1'); } catch {}
    };

    const mesurer = () => {
      const course = film.offsetHeight - window.innerHeight;
      avancement = course > 0 ? Math.min(1, Math.max(0, -film.getBoundingClientRect().top / course)) : 1;
      if (avancement > 0.97) memoriser();
    };

    // « Passer le film » : saut immédiat dans le site (sans faire défiler tout le film).
    film.querySelector('.film__passer')?.addEventListener('click', (e) => {
      e.preventDefault();
      memoriser();
      const cible = document.getElementById('bienvenue');
      cible?.scrollIntoView({ behavior: 'instant' });
      cible?.focus({ preventScroll: true });
    });

    // Affiche les textes selon l'image du film réellement à l'écran.
    const peindre = () => {
      film.style.setProperty('--p', avancement.toFixed(4));
      let voileMax = 0;
      let ombreMax = 0;
      for (const l of legendes) {
        let o = Math.min(1, Math.max(0, (temps - l.debut) / FONDU)) * Math.min(1, Math.max(0, (l.fin - temps) / FONDU));
        if (!duree && !l.avant) o = 0;
        l.el.style.opacity = o.toFixed(3);
        l.el.style.visibility = o > 0.02 ? 'visible' : 'hidden';
        l.el.style.transform = `translateY(${((1 - o) * 12).toFixed(1)}px)`;
        if (l.ombre) ombreMax = Math.max(ombreMax, o);
        voileMax = Math.max(voileMax, o * l.voile);
      }
      voile.style.opacity = voileMax.toFixed(3);
      ombre.style.opacity = ombreMax.toFixed(3);
    };

    const image = () => {
      const cible = duree ? tempsPour(avancement) : 0;
      temps += (cible - temps) * LISSAGE;
      if (Math.abs(cible - temps) < 0.003) temps = cible;
      peindre();
      // Pas de nouveau déplacement tant que le décodeur n'a pas fini le précédent (téléphones).
      if (duree && !video.seeking && Math.abs(video.currentTime - temps) > 0.01) {
        video.currentTime = Math.min(temps, duree - 0.05);
      }
      if (temps !== cible || video.seeking) requestAnimationFrame(image);
      else enCours = false;
    };

    const auScroll = () => {
      mesurer();
      if (!enCours) {
        enCours = true;
        requestAnimationFrame(image);
      }
    };

    const figer = () => {
      window.removeEventListener('scroll', auScroll);
      window.removeEventListener('resize', auScroll);
      film.classList.remove('est-anime');
      film.style.removeProperty('--p');
      voile.style.removeProperty('opacity');
      ombre.style.removeProperty('opacity');
      legendes.forEach((l) => l.el.removeAttribute('style'));
    };

    // Chargée en mémoire, une vidéo se parcourt dans les deux sens chez tous les hébergeurs.
    const remplir = async (el: HTMLVideoElement, url: string) => {
      const reponse = await fetch(url);
      if (!reponse.ok) throw new Error(`HTTP ${reponse.status}`);
      el.src = URL.createObjectURL(await reponse.blob());
      await new Promise((ok, ko) => {
        el.addEventListener('loadeddata', ok, { once: true });
        el.addEventListener('error', ko, { once: true });
      });
      await el.play().then(() => el.pause()).catch(() => {});  // iOS
    };

    // Pas de HD en mode économie de données ou sur une connexion lente.
    const connexion = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const hdPermise = !(connexion?.saveData || /(^|-)(2g|3g)$/.test(connexion?.effectiveType ?? ''));

    const passerEnHd = async (url: string) => {
      const hd = video.cloneNode(false) as HTMLVideoElement;
      hd.removeAttribute('src');
      hd.classList.add('film__video--hd');
      video.after(hd);
      try {
        await remplir(hd, url);
        hd.currentTime = Math.min(temps, duree - 0.05);
        await new Promise((ok) => hd.addEventListener('seeked', ok, { once: true }));
        hd.classList.add('est-visible');
        const ancienne = video;
        video = hd;
        film.classList.add('est-hd');
        auScroll();
        setTimeout(() => {
          URL.revokeObjectURL(ancienne.src);
          ancienne.remove();
        }, 600);
      } catch {
        hd.remove();  // on garde la version légère
      }
    };

    const charger = async () => {
      const sources = telephone ? SOURCES.telephone : SOURCES.ordinateur;
      try {
        await remplir(video, sources.leger);
        duree = video.duration;
        film.classList.add('est-pret');
        auScroll();
      } catch (erreur) {
        console.warn('Film indisponible : image fixe.', erreur);
        figer();
        return;
      }
      if (hdPermise) passerEnHd(sources.hd);
    };

    window.addEventListener('scroll', auScroll, { passive: true });
    window.addEventListener('resize', auScroll);
    mesurer();
    peindre();
    charger();
  }
</script>
