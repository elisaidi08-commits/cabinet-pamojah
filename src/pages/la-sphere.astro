---
// La Sphère de pouvoir : visible mais fermée. Aucun formulaire, aucune inscription.
// Texte composé à partir du brief V2 (§ Sphère de pouvoir) et des décisions du 18/09/2026 — à valider par Huguette.
import Base from '../layouts/Base.astro';
import Titre from '../components/Titre.astro';
import Cercles from '../components/Cercles.astro';
import { site } from '../data/site';

const cercles = [
  { nom: 'Le premier cercle', texte: 'Il s’ouvre après votre Consultation d’Axe. Huguette vous en donne l’accès.' },
  { nom: 'Les cercles intérieurs', texte: 'Chaque accompagnement plus profond ouvre un cercle plus proche du centre.' },
  { nom: 'Sur invitation', texte: 'Certains accès s’ouvrent sur invitation d’Huguette, à un moment choisi de votre parcours.' },
];
const espace = [
  'apprendre',
  'comprendre votre fonctionnement',
  'mieux saisir votre manière d’exercer votre influence',
  'prendre conscience de vos mécanismes',
  'développer une forme de maîtrise',
];
---
<Base title="La Sphère de pouvoir" description="La Sphère de pouvoir, le cœur du Cabinet Pamojah. Elle ne s’achète pas : elle s’ouvre après votre Consultation d’Axe.">
  <section class="section fond-noir sphere-tete">
    <div class="conteneur sphere-tete__grille">
      <div>
        <span class="surtitre">Le cœur du cabinet</span>
        <h1>La Sphère de pouvoir</h1>
        <p class="chapo espace">Elle ne s’achète pas. Elle s’ouvre après votre Consultation d’Axe.</p>
      </div>
      <Cercles />
    </div>
  </section>

  <section class="section fond-sable" aria-labelledby="espace-titre">
    <div class="conteneur deux-col">
      <Titre surtitre="Un espace réservé" id="espace-titre">Un lieu pour approfondir ce que l’accompagnement a ouvert</Titre>
      <div>
        <p class="chapo">La Sphère est réservée aux femmes accompagnées par le Cabinet Pamojah. Vous y venez pour :</p>
        <ul class="liste-filets espace">
          {espace.map((e) => <li>{e}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section fond-ivoire" aria-labelledby="cercles-titre">
    <div class="conteneur">
      <Titre surtitre="Comment on y entre" id="cercles-titre">Des cercles, du premier au plus proche du centre</Titre>
      <ol class="cercles-liste">
        {cercles.map((c, i) => (
          <li class="apparait" style={`--delai: ${i * 120}ms`}>
            <h3>{c.nom}</h3>
            <p>{c.texte}</p>
          </li>
        ))}
      </ol>
      <p class="note">Il n’existe pas d’inscription à la Sphère. Plus votre relation avec le Cabinet s’approfondit, plus certaines expériences deviennent accessibles.</p>
    </div>
  </section>

  <section class="section fond-noir" aria-labelledby="entrer-titre">
    <div class="conteneur centre entrer">
      <Titre surtitre={site.signature} id="entrer-titre" centre>La première porte est la Consultation d’Axe.</Titre>
      <a class="bouton espace" href="/consultation-axe/#reserver">Réserver ma Consultation d’Axe</a>
    </div>
  </section>
</Base>

<style>
  .espace { margin-top: var(--e-6); }
  .sphere-tete__grille {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--e-8);
    align-items: center;
  }
  .sphere-tete h1 { margin-top: var(--e-4); }
  .deux-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--e-8);
    align-items: start;
  }
  .cercles-liste {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--e-7);
    margin: var(--e-8) 0 0;
    padding: 0;
    list-style: none;
  }
  .cercles-liste li { padding-top: var(--e-5); border-top: 1px solid var(--or); }
  .cercles-liste h3 { margin-bottom: var(--e-3); }
  .note { max-width: 44rem; margin-top: var(--e-8); font-style: italic; }
  .entrer { max-width: 44rem; }
  @media (max-width: 900px) {
    .sphere-tete__grille, .deux-col, .cercles-liste { grid-template-columns: 1fr; }
  }
</style>
