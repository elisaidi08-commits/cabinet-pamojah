---
// L'architecte. Texte de la fondatrice (brief p.1–2), écrit à la 3e personne (décision du 28/09/2026),
// modifiable dans l'administration (« L'architecte (Huguette) » → src/contenu/huguette.json).
// Non publiés en attendant sa validation : le rôle en église, la formation de décoratrice, les autres entreprises.
// En haut de page : sa vidéo (public/film/huguette.mp4, verticale, sous-titrée), sans le son tant qu'elle ne l'active pas.
import Photo from '../components/Photo.astro';
import Base from '../layouts/Base.astro';
import Titre from '../components/Titre.astro';
import villa from '../assets/images/cabinet/hp-salon.jpg';
import h from '../contenu/huguette.json';
import accueil from '../contenu/accueil.json';
import { site, citer } from '../data/site';
import { empreinte } from '../data/fichiers';

---
<Base title="Huguette Tolo-Tolo Ngemeyeme" description="Huguette Tolo-Tolo Ngemeyeme, architecte de souveraineté et fondatrice du Cabinet Pamojah : infirmière pendant 17 ans, multi-entrepreneure.">
  <section class="section fond-noir tete">
    <div class="conteneur tete__grille">
      <div>
        <span class="surtitre">L’architecte</span>
        <h1>Huguette Tolo-Tolo Ngemeyeme</h1>
        <p class="devise espace-s">Architecte de souveraineté · Fondatrice du Cabinet Pamojah</p>
        <p class="chapo espace">{h.presentation}</p>
        {site.linkedin && <a class="lien espace" href={site.linkedin} rel="noopener">Son profil LinkedIn</a>}
      </div>
      <figure class="tete__video">
        <video
          src={empreinte('/film/huguette.mp4')}
          poster={empreinte('/film/affiche-huguette.jpg')}
          muted loop playsinline preload="metadata"
          aria-label="Huguette Tolo-Tolo Ngemeyeme : « C’est parce que j’ai cru que j’avais échoué que j’ai trouvé ma voie ! »"
        ></video>
        <button type="button" class="tete__son" aria-pressed="false">Activer le son</button>
      </figure>
    </div>
  </section>

  <section class="section fond-sable" aria-labelledby="souverainete">
    <div class="conteneur deux-col">
      <Titre surtitre="Sa posture" id="souverainete">Architecte de souveraineté</Titre>
      <div>
        {h.posture.map((p, i) => <p class:list={[i === 0 ? 'chapo' : 'espace-s']}>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section fond-ivoire" aria-labelledby="parcours">
    <div class="conteneur">
      <Titre surtitre="Son parcours" id="parcours">Riche en expériences et en expertises</Titre>
      <ul class="parcours">
        {h.parcours.map((p, i) => (
          <li class="apparait" style={`--delai: ${i * 100}ms`}>
            <h3>{p.titre}</h3>
            <p>{p.texte}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section fond-noir" aria-labelledby="genese">
    <div class="conteneur deux-col">
      <Titre surtitre="La genèse du Cabinet" id="genese">Pour la reconstruction d’une société en meilleure santé</Titre>
      <div class="genese">
        {h.genese.map((p) => <p>{p}</p>)}
        <blockquote class="genese__citation">
          <p>« {citer(h.citation)} »</p>
          <footer class="genese__signature">— Huguette Tolo-Tolo Ngemeyeme</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="ensemble fond-sable" aria-labelledby="ensemble-titre">
    <Photo src={villa} alt="" widths={[960, 1600, 2400]} sizes="100vw" class="ensemble__image" />
    <div class="ensemble__voile" aria-hidden="true"></div>
    <div class="conteneur centre ensemble__texte">
      <Titre surtitre={site.signature} id="ensemble-titre" centre>{accueil.retour}</Titre>
      <a class="bouton espace" href="/consultation-axe/#reserver">Réserver ma Consultation d’Axe</a>
    </div>
  </section>
</Base>

<style>
  .espace { margin-top: var(--e-6); }
  .espace-s { margin-top: var(--e-4); }
  .tete { padding-top: var(--e-10); }
  .tete__grille {
    display: grid;
    grid-template-columns: minmax(0, 9fr) minmax(0, 3fr);
    gap: var(--e-8);
    align-items: center;
  }
  .tete h1 { margin-top: var(--e-4); max-width: 14ch; }
  .tete .chapo { max-width: 40rem; }
  .tete__video { position: relative; margin: 0; }
  .tete__video video { display: block; width: 100%; aspect-ratio: 9 / 16; object-fit: cover; background: #000; }
  .tete__son {
    position: absolute; right: 12px; bottom: 12px;
    min-height: 44px; padding: 0 16px;
    font-family: var(--f-capitales); font-size: 11.5px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--ivoire); background: rgba(13, 13, 13, 0.65); border: 1px solid var(--or); cursor: pointer;
  }
  .tete__son:hover, .tete__son:focus-visible { background: rgba(13, 13, 13, 0.85); }

  .deux-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--e-8);
    align-items: start;
  }
  .parcours {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-7) var(--e-8);
    margin: var(--e-8) 0 0;
    padding: 0;
    list-style: none;
  }
  .parcours li { padding-top: var(--e-5); border-top: 1px solid var(--or); }
  .parcours h3 { margin-bottom: var(--e-3); }

  .genese p + p { margin-top: 1em; }
  .genese__signature { margin-top: var(--e-4); font-style: normal; font-size: 17px; color: var(--or); }
  .genese__citation { margin: var(--e-7) 0 0; padding-left: var(--e-5); border-left: 1px solid var(--or); }
  .genese__citation p { font-size: clamp(24px, 1.2vw + 18px, 32px); font-style: italic; line-height: 1.3; }

  .ensemble { position: relative; overflow: hidden; color: var(--ivoire); padding-block: var(--section); }
  :global(.ensemble__image) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ensemble__voile { position: absolute; inset: 0; background: rgba(13, 13, 13, 0.6); }
  .ensemble__texte { position: relative; max-width: 46rem; }
  .ensemble :global(.surtitre) { color: var(--or); }

  @media (max-width: 900px) {
    .tete__grille, .deux-col, .parcours { grid-template-columns: 1fr; }
    .tete__video { max-width: 22rem; }
  }
</style>

<script>
  // La vidéo d'Huguette : en boucle et sans le son ; le bouton active ou coupe le son.
  // Mouvement réduit demandé : elle ne démarre pas d'elle-même (l'affiche reste, le bouton la lance avec le son).
  const video = document.querySelector<HTMLVideoElement>('.tete__video video');
  const bouton = document.querySelector<HTMLButtonElement>('.tete__son');

  if (video && bouton) {
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) video.play().catch(() => {});
    bouton.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted) video.play().catch(() => {});
      bouton.textContent = video.muted ? 'Activer le son' : 'Couper le son';
      bouton.setAttribute('aria-pressed', String(!video.muted));
    });
  }
</script>
